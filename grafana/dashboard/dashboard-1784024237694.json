                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "efrlmijfvocg0f"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(1 - sum(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) / sum(rate(node_cpu_seconds_total[5m]))) * 100",
                        "legendFormat": "__auto",
                        "range": true
                      }
