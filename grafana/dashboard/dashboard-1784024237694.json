          "id": 1,
          "title": "Utilisation CPU",
          "description": "Cette requête calcule la charge CPU globale en soustrayant le temps passé par le processeur à ne rien faire (mode=\"idle\").",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
